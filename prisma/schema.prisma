}

model ActionTranslation {
  actionCode String           @map("action_code")
  localeCode String           @map("locale_code")
  name       String
  action     PermissionAction @relation(fields: [actionCode], references: [code], onDelete: Cascade)
  locale     Locale           @relation(fields: [localeCode], references: [code], onDelete: NoAction)

  @@id([actionCode, localeCode])
  @@map("action_translations")
}

model ActivityLog {
  id                    BigInt   @id @default(autoincrement())
  actorUserId           BigInt?  @map("actor_user_id")
  actorUsernameSnapshot String   @map("actor_username_snapshot")
  actorRoleSnapshot     String   @map("actor_role_snapshot")
  actionCode            String   @map("action_code")
  moduleCode            String?  @map("module_code")
  entityTable           String?  @map("entity_table")
  entityId              BigInt?  @map("entity_id")
  summary               String
  changeDiff            Json?    @map("change_diff")
  ipAddress             String?  @db.Inet @map("ip_address")
  createdAt             DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  actor                 User?    @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)
  module                Module?  @relation(fields: [moduleCode], references: [code], onDelete: NoAction)

  @@index([actorUserId, createdAt(sort: Desc)], map: "ix_activity_actor")
  @@index([entityTable, entityId, createdAt(sort: Desc)], map: "ix_activity_entity")
  @@index([createdAt(sort: Desc)], map: "ix_activity_recent")
  @@map("activity_logs")
}

