  locale       Locale     @relation(fields: [localeCode], references: [code], onDelete: NoAction)

  @@id([classGradeId, localeCode])
  @@map("class_grade_translations")
}

model ClassGrade {
  id                     BigInt                  @id @default(autoincrement())
  code                   String                  @unique
  classStageId           BigInt?                 @map("class_stage_id")
  sortOrder              Int                     @default(0) @db.SmallInt @map("sort_order")
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt              DateTime?               @db.Timestamptz(6) @map("deleted_at")
  deletedByUserId        BigInt?                 @map("deleted_by_user_id")
  admissionEligibility   AdmissionEligibility?
  classGradeTranslations ClassGradeTranslation[]
  classStage             ClassStage?             @relation(fields: [classStageId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  deletedBy              User?                   @relation(fields: [deletedByUserId], references: [id], onUpdate: NoAction)
  classRoutines          ClassRoutine[]
  classSections          ClassSection[]
  classSubjects          ClassSubject[]
  exams                  Exam[]
  feeStructures          FeeStructure[]

  @@map("class_grades")
}

model ClassRoutine {
  id               BigInt        @id @default(autoincrement())
  classGradeId     BigInt        @map("class_grade_id")
  classSectionId   BigInt?       @map("class_section_id")
  academicYearId   BigInt        @map("academic_year_id")
  mediaId          BigInt        @map("media_id")
  effectiveFrom    DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date @map("effective_from")
  isCurrent        Boolean       @default(true) @map("is_current")
  uploadedByUserId BigInt?       @map("uploaded_by_user_id")
  createdAt        DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt        DateTime?     @db.Timestamptz(6) @map("deleted_at")
  academicYear     AcademicYear  @relation(fields: [academicYearId], references: [id], onUpdate: NoAction)
  classGrade       ClassGrade    @relation(fields: [classGradeId], references: [id], onUpdate: NoAction)
  media            MediaAsset    @relation(fields: [mediaId], references: [id], onUpdate: NoAction)
  uploadedBy       User?         @relation(fields: [uploadedByUserId], references: [id], onUpdate: NoAction)
  classSection     ClassSection? @relation(fields: [classSectionId, classGradeId, academicYearId], references: [id, classGradeId, academicYearId], onDelete: SetNull, onUpdate: NoAction, map: "fk_routine_section")

  @@map("class_routines")
}

model ClassSection {
  id                      BigInt                   @id @default(autoincrement())
  classGradeId            BigInt                   @map("class_grade_id")
  academicYearId          BigInt                   @map("academic_year_id")
  name                    String
  capacity                Int?                     @db.SmallInt
  isActive                Boolean                  @default(true) @map("is_active")
  classRoutines           ClassRoutine[]
  academicYear            AcademicYear             @relation(fields: [academicYearId], references: [id], onUpdate: NoAction)
  classGrade              ClassGrade               @relation(fields: [classGradeId], references: [id], onUpdate: NoAction)
  facultyClassAssignments FacultyClassAssignment[]

  @@unique([classGradeId, academicYearId, name])
  @@unique([id, classGradeId, academicYearId])
  @@map("class_sections")
}

