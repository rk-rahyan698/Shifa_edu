  note                   String?
  admissionEligibility   AdmissionEligibility @relation(fields: [admissionEligibilityId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admission_eligibility_translation_admission_eligibility_id_fkey")
  locale                 Locale               @relation(fields: [localeCode], references: [code], onDelete: NoAction)

  @@id([admissionEligibilityId, localeCode])
