model ContactMessage {
  id              BigInt               @id @default(autoincrement())
  uid             String               @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  phone           String
  email           String?
  message         String
  localeCode      String?              @map("locale_code")
