# Shifa International School — environment template
#
# Copy to `.env.local` and fill in. Never commit a filled-in file:
# ARCHITECTURE.md §A-12 — "Secrets: environment only; no credential literal in
# any repo file or document". `.gitignore` blocks every `.env*` except this one.
#
# Every key below is REQUIRED unless the comment says otherwise. The loader in
# src/lib/env.ts validates them at boot and refuses to start if one is missing
# or malformed. Modules read `env` from that file — never `process.env`.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production. Optional; defaults to development.
NODE_ENV=

# ---------------------------------------------------------------------------
# Public site (inlined into the browser bundle — must contain no secret)
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, hreflang,
# sitemap.xml and robots.txt. Example shape: https://example.org
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Database (T-004 wires Prisma to this; nothing connects yet)
# ---------------------------------------------------------------------------
# postgresql://user:password@host:5432/database?schema=public
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sessions (T-032)
# ---------------------------------------------------------------------------
# Random 32+ byte secret, base64 or hex. Rotate on handover (T-132).
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Transactional email — password reset, notifications (T-042)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# From address on outgoing mail, e.g. no-reply@example.org
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Object storage — two buckets, public (CDN-served) and private (signed URLs
# only), per ARCHITECTURE.md §A-10 (T-037)
# ---------------------------------------------------------------------------
# S3-compatible API endpoint, e.g. https://s3.example-region.provider.com
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BUCKET=
STORAGE_PRIVATE_BUCKET=
# Public read origin for the public bucket (CDN or bucket URL), no trailing slash
STORAGE_PUBLIC_BASE_URL=
