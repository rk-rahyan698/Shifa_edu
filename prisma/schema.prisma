// Prisma is a CLIENT OVER AUTHORITATIVE SQL, not the source of the schema.
// ARCHITECTURE.md Part B is the schema; the hand-written migrations in
// prisma/migrations are what create it; this file maps TypeScript onto what is
// already there (§B-18, T-023).
//
// Contract (T-023): PRISMA NEVER OWNS THE SCHEMA. Do not run `prisma migrate
// dev` against this file to change the database - it would generate SQL from
// the model list and silently drop everything Prisma cannot express. Change
// Part B first, then hand-write a migration, then re-map here. `prisma db pull`
// is the safe direction; `prisma migrate diff --from-schema-datamodel
// --to-schema-datasource` is what proves the two still agree.
//
// This file was produced by introspecting the 15 applied migrations and then
// hand-correcting the naming: models are PascalCase singular over @@map, fields
// are camelCase over @map, and the relation fields Prisma generates as
// `users_notices_author_user_idTousers` are named for the role they play
// (`author`, `publishedBy`, `deletedBy`). Every translation model keeps the
// composite @@id([<parent>Id, localeCode]) §B-18 requires.
//
// NO ENUMS. The lookup tables - roles, modules, permission_actions,
// content_statuses, notice_categories, gallery_categories, fee_types,
// designations, class_stages and the rest - stay relations. Converting them to
// Prisma enums would reintroduce ADR-002 and put a migration in the way of
// adding a category, which is exactly what §B-3 exists to prevent.
//
// WHAT PRISMA CANNOT SEE, and where it actually lives:
//   - CHECK constraints (singleton id = 1, the three consent checks, the date
//     ranges, ck_stat_verified, ck_notice_published) - migrations 0002-0015
//   - partial indexes (every public read index has a WHERE clause) and the GIN
//     expression index ix_notice_fts - migrations 0010-0014
//   - REVOKE UPDATE, DELETE ON activity_logs - migration 0013
//   - ContactMessage.purgeAfter is GENERATED ALWAYS ... STORED, which Prisma
//     models as an ordinary default. It is @ignore'd so no generated client
//     type can offer to write it; read it with a raw query (§B-18).
// None of these are optional refinements. They are correctness guarantees, and
// they are invisible here by necessity, not by omission.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AboutContent {
  id                        Int                       @id @default(1) @db.SmallInt
  principalPhotoMediaId     BigInt?                   @map("principal_photo_media_id")
  principalSignatureMediaId BigInt?                   @map("principal_signature_media_id")
  updatedAt                 DateTime                  @default(now()) @db.Timestamptz(6) @map("updated_at")
  updatedByUserId           BigInt?                   @map("updated_by_user_id")
  principalPhoto            MediaAsset?               @relation("AboutContentPrincipalPhoto", fields: [principalPhotoMediaId], references: [id], onUpdate: NoAction)
  principalSignature        MediaAsset?               @relation("AboutContentPrincipalSignature", fields: [principalSignatureMediaId], references: [id], onUpdate: NoAction)
  updatedBy                 User?                     @relation(fields: [updatedByUserId], references: [id], onUpdate: NoAction)
  aboutContentTranslations  AboutContentTranslation[]

  @@map("about_content")
}

model AboutContentTranslation {
  aboutContentId       Int          @db.SmallInt @map("about_content_id")
  localeCode           String       @map("locale_code")
  historyHtml          String?      @map("history_html")
  visionHtml           String?      @map("vision_html")
  missionHtml          String?      @map("mission_html")
  principalMessageHtml String?      @map("principal_message_html")
  principalName        String?      @map("principal_name")
  principalDesignation String?      @map("principal_designation")
  aboutContent         AboutContent @relation(fields: [aboutContentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  locale               Locale       @relation(fields: [localeCode], references: [code], onDelete: NoAction)

  @@id([aboutContentId, localeCode])
  @@map("about_content_translations")
}

